    function formatEmbedUrl(url) {
        if(url.includes('/edit')) {
            return url.replace(/\/edit.*$/, '/edit?usp=sharing&embedded=true');
        } else if(!url.includes('embedded=true')) {
            return url + (url.includes('?') ? '&' : '?') + 'embedded=true';
        }
        return url;
    }

    let linkDB = formatEmbedUrl(rawLinkDB);

    function muatDataDariSpreadsheet() {
        fetch(WEB_APP_URL)
            .then(res => res.json())
            .then(response => {
                if(response.pengadaan) {
                    let mappedPengadaan = response.pengadaan.map((item, originalIndex) => {
                        const val = (key) => {
                            for (let k in item) {
                                if (k.toLowerCase().replace(/[^a-z0-9]/g, '') === key.toLowerCase().replace(/[^a-z0-9]/g, '')) return item[k];
                            }
                            return '';
                        };

                        return {
                            originalNo: originalIndex + 1,
                            id: Number(val('id')) || Date.now(),
                            tim: val('timyangmengajukan') || val('tim') || '',
                            tglAjuan: val('tanggalajuan') || val('tglajuan') || '',
                            namaPekerjaan: val('namapekerjaan') || '',
                            review: val('review') || '',
                            durasiWaktu: val('durasiwaktu') || '',
