                            kodeMak: val('kodemak') || '',
                            nilaiPagu: Number(val('nilaipagudipa') || val('nilaipagu')) || 0,
                            paguKontrak: Number(val('pagukontrak')) || 0,
                            hpsKontrak: Number(val('hpskontrak')) || 0,
                            nilaiKontrak: Number(val('nilaikontrak')) || 0,
                            metodePekerjaan: val('metodepekerjaan') || '',
                            jenisBelanja: val('jenisbelanja') || '',
                            bentukKontrak: val('dokumenkontrak') || val('bentukkontrak') || '',
                            statusDokumen: val('statusdokumen') || '',
                            noKontrak: val('nomorkontrakspk') || val('nokontrak') || '',
                            tglKontrak: val('tanggalspk') || val('tglkontrak') || '',
                            nilaiSesuaiDok: Number(val('nilaikontraksesuaidok') || val('nilaisuesaidok')) || 0,
                            nilaiAddendum: Number(val('nilaiaddendum')) || 0,
                            namaPenyedia: val('namapenyedia') || '-',
                            linkScan: val('linkscandokumenkontrak') || val('linkscan') || '',
                            spse: val('pencatatanidspse') || val('spse') || ''
                        };
                    });
                    dataPengadaan = mappedPengadaan.reverse();
                }

                if(response.spk) {
                    let mappedSpk = response.spk.map((item) => {
                        const val = (key) => {
                            for (let k in item) {
                                if (k.toLowerCase().replace(/[^a-z0-9]/g, '') === key.toLowerCase().replace(/[^a-z0-9]/g, '')) return item[k];
                            }
                            return '';
                        };

                        return {
                            id: Number(val('id')),
                            noMak: val('nomak') || '-',
                            noKontrak: val('nokontrak') || '-',
                            tglKontrak: val('tglkontrak') || '-',
                            uraian: val('uraianpekerjaan') || val('uraian') || '-',
                            penyedia: val('penyediajasa') || val('penyedia') || '-',
                            nilaiKontrak: Number(val('nilaikontrak')) || 0,
                            noAddendum: val('noaddendum') || '-',
                            tglAddendum: val('tgladdendum') || '-',
