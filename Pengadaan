        let sumSpm = 0;
        let sumSp2d = 0;
        let sumPpn = 0;
        let sumPph = 0;

        dataSpkKeuangan.forEach(item => {
            sumSpm += (item.nilaiSpm || 0);
            sumSp2d += (item.nilaiSp2d || 0);
            sumPpn += (item.ppn || 0);
            sumPph += (item.pph || 0);
