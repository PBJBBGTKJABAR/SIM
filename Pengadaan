<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SIM Pengadaan BBGTK Provinsi Jawa Barat</title>
    <!-- Google Fonts: Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <!-- Library untuk Konversi ke PDF -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f4f6f9;
            font-size: 0.9rem;
        }
        /* CONTAINER UTAMA TABEL DENGAN SCROLL */
        .table-scroll-container {
            max-height: 72vh;
            overflow-y: auto;
            position: relative;
        }
        /* STICKY TABLE HEADER YANG RAPI */
        .table-custom thead th {
            position: sticky;
            top: 0;
            z-index: 10;
            background-color: #212529 !important;
            color: #fff;
            box-shadow: inset 0 -1px 0 #32383e;
        }
        .sub-row {
            background-color: #f8f9fa;
            font-size: 0.8rem;
            color: #555;
        }
        .table-custom th {
            vertical-align: middle;
            text-align: center;
            font-size: 0.8rem;
        }
        .table-matrix th, .table-matrix td {
            text-align: center;
            vertical-align: middle;
            font-size: 0.82rem;
            padding: 0.4rem;
        }
        .table-matrix th {
            background-color: #f2f2f2;
        }
        .card {
            border: none;
            box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
            border-radius: 16px;
        }
        .clickable-title {
            color: #0d6efd;
            cursor: pointer;
            text-decoration: none;
        }
        .clickable-title:hover {
            text-decoration: underline;
        }
        /* Badge styling untuk Penomoran */
        .badge-pengadaan { font-size: 0.75rem; padding: 0.5em 0.8em; border-radius: 8px; font-weight: 600; }
        .badge-soft-primary { background-color: #dbeafe; color: #1e40af; }
        .badge-soft-danger { background-color: #fee2e2; color: #991b1b; }
        .badge-soft-info { background-color: #cffafe; color: #155e75; }
        .badge-soft-warning { background-color: #fef3c7; color: #92400e; }
        .badge-soft-success { background-color: #d1fae5; color: #065f46; }
        .badge-soft-secondary { background-color: #f1f5f9; color: #475569; }
        .btn-action { padding: 0.35rem 0.6rem; font-size: 0.75rem; border-radius: 6px; box-shadow: none; border-width: 1.5px; }
        
        .empty-state { padding: 40px 20px; text-align: center; color: #94a3b8; }
        .empty-state i { font-size: 3rem; color: #cbd5e1; margin-bottom: 15px; }

        /* Custom Footer */
        .custom-footer {
            background: linear-gradient(135deg, #0f172a, #1e3a8a);
            color: #cbd5e1;
            text-align: center;
            padding: 12px 0;
            font-size: 12.5px;
            font-weight: 500;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(15, 23, 42, 0.1);
            margin-top: 40px; 
            margin-bottom: 15px; 
        }
        .custom-footer .designer-name { color: #60a5fa; font-weight: 700; letter-spacing: 0.5px; }
        .custom-footer .ai-text { color: #f8fafc; font-weight: 600; }
        .custom-footer i { color: #3b82f6; margin: 0 4px; font-size: 13px; }

        /* Overlay Loading Screen */
        #loadingOverlay {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%; 
            background: rgba(255,255,255,0.9); z-index: 9999; 
            display: flex; flex-direction: column; justify-content: center; align-items: center;
        }
        .spinner-border { width: 3rem; height: 3rem; color: #2563eb; }
        @media print {
            body * { visibility: hidden; }
            #printArea, #printArea * { visibility: visible; }
            #printArea { position: absolute; left: 0; top: 0; width: 100%; }
            .no-print { display: none !important; }
        }
    </style>
</head>
<body>

<!-- Overlay Loading Screen -->
<div id="loadingOverlay">
    <div class="spinner-border mb-3" role="status"></div>
    <h5 class="fw-bold text-slate-700" id="loadingText">Menghubungkan ke Cloud...</h5>
    <p class="text-muted small">Harap tunggu sebentar</p>
</div>

<div class="container-fluid py-3 px-4">
    
    <!-- HEADER & NAVIGASI TAB UTAMA -->
    <div class="mb-3">
        <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
            <h4 class="fw-bold text-dark mb-0">SIM Pengadaan BBGTK Provinsi Jawa Barat</h4>
            <ul class="nav nav-pills" id="pills-tab" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active py-1 px-3 mb-1" data-bs-toggle="pill" data-bs-target="#tab-list" type="button" role="tab">Daftar Pengadaan</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link py-1 px-3 mb-1" data-bs-toggle="pill" data-bs-target="#tab-rekap" type="button" role="tab">📊 Rekap Pengadaan</button>
                </li>
                <!-- MENU BARU SESUAI PERMINTAAN -->
                <li class="nav-item" role="presentation">
                    <button class="nav-link py-1 px-3 mb-1" data-bs-toggle="pill" data-bs-target="#tab-penomoran" type="button" role="tab">📑 Penomoran Kontrak</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link py-1 px-3 mb-1" data-bs-toggle="pill" data-bs-target="#tab-spk" type="button" role="tab">💰 Rekap SPK Keuangan</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link py-1 px-3 mb-1" data-bs-toggle="pill" data-bs-target="#tab-database" type="button" role="tab">📂 Rekap Data Base SIM</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link py-1 px-3 mb-1" data-bs-toggle="pill" data-bs-target="#tab-setting" type="button" role="tab">⚙️ Pengaturan</button>
                </li>
            </ul>
        </div>
    </div>

    <!-- KONTEN UTAMA (TAB SYSTEM) -->
    <div class="tab-content" id="pills-tabContent">
        
        <!-- TAB 1: DAFTAR PENGADAAN -->
        <div class="tab-pane fade show active" id="tab-list" role="tabpanel">
            <div class="card mb-3">
                <div class="card-body py-2">
                    <div class="row g-2 align-items-center">
                        <div class="col-md-4">
                            <input type="text" id="cariKeyword" class="form-control form-control-sm" placeholder="🔍 Cari Pekerjaan / Penyedia..." onkeyup="renderAplikasi()">
                        </div>
                        <div class="col-md-3">
                            <select id="filterPic" class="form-select form-select-sm" onchange="renderAplikasi()">
                                <option value="">-- Semua Petugas Pengadaan --</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <select id="filterStatus" class="form-select form-select-sm" onchange="renderAplikasi()">
                                <option value="">-- Semua Status Review --</option>
                                <option value="Review PPK">Review PPK</option>
                                <option value="Proses Pekerjaan">Proses Pekerjaan</option>
                                <option value="Pending">Pending</option>
                                <option value="Batal">Batal</option>
                            </select>
                        </div>
                        <div class="col-md-2 text-end">
                            <button type="button" class="btn btn-primary btn-sm w-100" onclick="bukaModalTambah()">+ Ajuan Baru</button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-body p-2">
                    <div class="table-scroll-container">
                        <table class="table table-bordered align-middle table-custom mb-0">
                            <thead class="table-dark">
                                <tr>
                                    <th width="4%">No</th>
                                    <th width="36%">Informasi Utama Pekerjaan & Tim</th>
                                    <th width="25%">Anggaran & Metode</th>
                                    <th width="25%">Status & Dokumen Kontrak</th>
                                    <th width="10%">Aksi</th>
                                </tr>
                            </thead>
                            <tbody id="tabelData">
                                <tr><td colspan="5" class="text-center text-muted py-4">Memuat data dari Google Spreadsheet (Sheet1)...</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- TAB 2: MENU REKAP PENGADAAN (MATRIKS) -->
        <div class="tab-pane fade" id="tab-rekap" role="tabpanel">
            <div class="row mb-3">
                <div class="col-md-6">
                    <div class="card bg-primary text-white">
                        <div class="card-body py-3">
                            <h6 class="card-title mb-1" style="font-size: 0.85rem;">Total Keseluruhan Kontrak</h6>
                            <h4 id="rekapTotalPaket" class="mb-0 fw-bold">0 Paket</h4>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card bg-success text-white">
                        <div class="card-body py-3">
                            <h6 class="card-title mb-1" style="font-size: 0.85rem;">Akumulasi Nilai Kontrak</h6>
                            <h4 id="rekapTotalNilai" class="mb-0 fw-bold">Rp 0</h4>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-header bg-secondary text-white py-2 d-flex justify-content-between align-items-center">
                    <h6 class="mb-0 fw-semibold">Matriks Rekapitulasi Kontrak per Petugas Pengadaan</h6>
                    <button class="btn btn-light btn-sm text-dark fw-bold py-0" onclick="eksporRekapCSV()">📥 Unduh Matriks Rekap (CSV)</button>
                </div>
                <div class="card-body p-2">
                    <div class="table-responsive">
                        <table class="table table-bordered table-matrix mb-0">
                            <thead>
                                <tr>
                                    <th rowspan="2" class="align-middle bg-warning text-dark" style="min-width: 120px;">Petugas Pengadaan</th>
                                    <th rowspan="2" class="align-middle bg-danger text-white">JUMLAH KONTRAK</th>
                                    <th colspan="4" class="bg-info text-white">Metode Pembayaran</th>
                                    <th colspan="6" class="bg-primary text-white">Penetapan Barang / Jasa</th>
                                    <th colspan="3" class="bg-secondary text-white">Status Dokumen</th>
                                    <th colspan="3" class="bg-dark text-white">Pencatatan di SPSE</th>
                                </tr>
                                <tr>
                                    <th class="bg-light">LS</th>
                                    <th class="bg-light">LS Kontrak</th>
                                    <th class="bg-light">UP/TUP</th>
                                    <th class="bg-light">UP/TUP Kontrak</th>
                                    <th class="bg-light">Barang (B)</th>
                                    <th class="bg-light">Konstruksi (PK)</th>
                                    <th class="bg-light">Jasa Kons. (JK)</th>
                                    <th class="bg-light">Jasa Akom. (JL)</th>
                                    <th class="bg-light">Jasa Konsum. (JL)</th>
                                    <th class="bg-light">Jasa Lainnya (JL)</th>
                                    <th class="bg-light text-secondary">Proses Dokumen</th>
                                    <th class="bg-light text-secondary">TTD PPK</th>
                                    <th class="bg-light text-secondary">Arsip PIC</th>
                                    <th class="bg-light text-dark">Belum Tercatat</th>
                                    <th class="bg-light text-dark">Sudah Draf</th>
                                    <th class="bg-light text-dark">Paket Selesai</th>
                                </tr>
                            </thead>
                            <tbody id="tabelMatriksRekap"></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- TAB BARU: PENOMORAN KONTRAK (SISTEM PENOMORAN SURAT TERINTEGRASI) -->
        <div class="tab-pane fade" id="tab-penomoran" role="tabpanel">
            <!-- Sub-navigasi internal Penomoran Kontrak -->
            <ul class="nav nav-tabs mb-3" id="penomoranSubTab" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active fw-bold" id="subtab-ajuan-btn" data-bs-toggle="tab" data-bs-target="#subtab-ajuan" type="button" role="tab">Data Ajuan</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link fw-bold" id="subtab-rekap-btn" data-bs-toggle="tab" data-bs-target="#subtab-rekap" type="button" role="tab">Rekap Nomor Surat</button>
                </li>
            </ul>

            <div class="tab-content" id="penomoranSubContent">
                <!-- Sub-tab 1: Data Ajuan -->
                <div class="tab-pane fade show active" id="subtab-ajuan" role="tabpanel">
                    <div class="d-flex justify-content-between align-items-center mb-3 px-1">
                        <h5 class="fw-bold m-0 text-slate-800">Dashboard Ajuan Nomor Surat</h5>
                        <div class="d-flex gap-2">
                            <button class="btn btn-light border text-secondary btn-sm d-flex align-items-center gap-1" onclick="tarikDataTerbaru()">
                                <i class="bi bi-arrow-clockwise"></i> Refresh Data
                            </button>
                            <button class="btn btn-primary btn-sm d-flex align-items-center gap-1" onclick="bukaModalAjuanPenomoran()">
                                <i class="bi bi-plus-circle-fill"></i> Tambah Ajuan
                            </button>
                        </div>
                    </div>
                    <div class="card">
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table align-middle">
                                    <thead>
                                        <tr>
                                            <th class="text-center" style="width: 5%">No</th>
                                            <th>Pejabat Pengadaan</th>
                                            <th>Nama Pekerjaan</th>
                                            <th class="text-center">Jenis Pengadaan</th>
                                            <th>Penyedia Barang/Jasa</th>
                                            <th class="text-center">Jumlah Nomor Surat</th>
                                            <th class="text-center" style="width: 18%">Aksi</th>
                                        </tr>
                                    </thead>
                                    <tbody id="tabelAjuanPenomoran"></tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Sub-tab 2: Rekap Nomor Surat -->
                <div class="tab-pane fade" id="subtab-rekap" role="tabpanel">
                    <div class="d-flex justify-content-between align-items-center mb-3 px-1">
                        <h5 class="fw-bold m-0 text-slate-800">Rekapitulasi Nomor Surat PBJ BBGTK Jabar</h5>
                        <span class="badge bg-success text-white py-2 px-3 shadow-sm rounded-pill"><i class="bi bi-cloud-check-fill me-1"></i> Tersinkronisasi Otomatis</span>
                    </div>
                    <div class="card">
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-striped align-middle">
                                    <thead>
                                        <tr>
                                            <th class="text-center">No Urut</th>
                                            <th>Nomor Surat Lengkap</th>
                                            <th>Perihal Dokumen</th>
                                            <th>Tanggal</th>
                                            <th>Nama Pekerjaan</th>
                                            <th>Penyedia</th>
                                        </tr>
                                    </thead>
                                    <tbody id="tabelRekapGlobalPenomoran"></tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- TAB 4: REKAP SPK KEUANGAN -->
        <div class="tab-pane fade" id="tab-spk" role="tabpanel">
            <div class="row mb-3 g-2">
                <div class="col-md-3">
                    <div class="card bg-primary text-white shadow-sm">
                        <div class="card-body py-2 px-3">
                            <small class="text-white-50 fw-semibold">Total Nilai SPM</small>
                            <h5 id="infografisTotalSpm" class="mb-0 fw-bold">Rp 0</h5>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card bg-success text-white shadow-sm">
                        <div class="card-body py-2 px-3">
                            <small class="text-white-50 fw-semibold">Total Nilai SP2D</small>
                            <h5 id="infografisTotalSp2d" class="mb-0 fw-bold">Rp 0</h5>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card bg-warning text-dark shadow-sm">
                        <div class="card-body py-2 px-3">
                            <small class="text-dark-50 fw-semibold">Total PPN</small>
                            <h5 id="infografisTotalPpn" class="mb-0 fw-bold">Rp 0</h5>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card bg-danger text-white shadow-sm">
                        <div class="card-body py-2 px-3">
                            <small class="text-white-50 fw-semibold">Total PPh</small>
                            <h5 id="infografisTotalPph" class="mb-0 fw-bold">Rp 0</h5>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm mb-3">
                <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center py-2">
                    <h6 class="mb-0">Daftar Rekap SPK & Keuangan</h6>
                    <button type="button" class="btn btn-success btn-sm" onclick="bukaModalSPK()">+ Input Data SPK Keuangan</button>
                </div>
                <div class="card-body p-2">
                    <div class="table-responsive">
                        <table class="table table-bordered align-middle table-custom mb-0" style="font-size: 0.8rem;">
                            <thead class="table-secondary text-center">
                                <tr>
                                    <th>No</th>
                                    <th>No MAK</th>
                                    <th>No & Tgl Kontrak</th>
                                    <th>Uraian Pekerjaan</th>
                                    <th>Penyedia Jasa</th>
                                    <th>Nilai Kontrak</th>
                                    <th>Addendum Kontrak</th>
                                    <th>BAST</th>
                                    <th>Cara Pembayaran</th>
                                    <th>Petugas Pengadaan</th>
                                    <th>SPM & SP2D</th>
                                    <th>Nilai Keuangan (SPM/Pajak/SP2D)</th>
                                    <th>Aksi</th>
                                </tr>
                            </thead>
                            <tbody id="tabelSpkKeuangan">
                                <tr><td colspan="13" class="text-center text-muted py-4">Memuat data dari Google Spreadsheet (Sheet2)...</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- TAB 5: REKAP DATA BASE SIM -->
        <div class="tab-pane fade" id="tab-database" role="tabpanel">
            <div class="card shadow-sm">
                <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center py-2">
                    <h6 class="mb-0">Rekap Data Base SIM (Google Spreadsheet Keseluruhan)</h6>
                    <a id="linkTabDB" href="#" target="_blank" class="btn btn-success btn-sm">🔗 Buka di Tab Baru Google Sheets</a>
                </div>
                <div class="card-body p-2">
                    <div class="ratio ratio-16x9" style="min-height: 600px;">
                        <iframe id="iframeDB" src="" allowfullscreen></iframe>
                    </div>
                </div>
            </div>
        </div>

        <!-- TAB 6: PENGATURAN -->
        <div class="tab-pane fade" id="tab-setting" role="tabpanel">
            <div class="card shadow-sm mb-4 border-primary">
                <div class="card-header bg-primary text-white py-2">
                    <h6 class="mb-0 fs-6">🔗 Pengaturan Link Google Spreadsheet (Database SIM)</h6>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Link Google Spreadsheet:</label>
                        <div class="input-group input-group-sm">
                            <input type="text" id="inputLinkDB" class="form-control" placeholder="https://docs.google.com/spreadsheets/d/...">
                            <button class="btn btn-success" type="button" onclick="simpanLink('db')">Simpan Link DB</button>
                        </div>
                    </div>
                    <hr>
                    <div>
                        <label class="form-label fw-bold">Ekspor Data SIM (CSV):</label>
                        <div>
                            <button type="button" class="btn btn-success btn-sm" onclick="eksporKeCSV()">📥 Ekspor Data Pengadaan</button>
                            <button type="button" class="btn btn-primary btn-sm ms-2" onclick="eksporSpkCSV()">📥 Ekspor Data SPK</button>
                            <button type="button" class="btn btn-secondary btn-sm ms-2" onclick="eksporRekapCSV()">📥 Unduh Matriks Rekap Lengkap</button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <div class="card shadow-sm h-100">
                        <div class="card-header bg-dark text-white py-2"><h6 class="mb-0 fs-6">Kelola Data PPK</h6></div>
                        <div class="card-body">
                            <div class="input-group input-group-sm mb-2">
                                <input type="text" id="inputMasterPpk" class="form-control" placeholder="Baru...">
                                <button class="btn btn-success" type="button" onclick="tambahMaster('ppk')">Tambah</button>
                            </div>
                            <ul class="list-group" id="listMasterPpk" style="max-height: 180px; overflow-y: auto;"></ul>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 mb-3">
                    <div class="card shadow-sm h-100">
                        <div class="card-header bg-dark text-white py-2"><h6 class="mb-0 fs-6">Kelola Petugas Pengadaan</h6></div>
                        <div class="card-body">
                            <div class="input-group input-group-sm mb-2">
                                <input type="text" id="inputMasterPic" class="form-control" placeholder="Baru...">
                                <button class="btn btn-success" type="button" onclick="tambahMaster('pic')">Tambah</button>
                            </div>
                            <ul class="list-group" id="listMasterPic" style="max-height: 180px; overflow-y: auto;"></ul>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 mb-3">
                    <div class="card shadow-sm h-100">
                        <div class="card-header bg-dark text-white py-2"><h6 class="mb-0 fs-6">Kelola Petugas POKMIL/PP</h6></div>
                        <div class="card-body">
                            <div class="input-group input-group-sm mb-2">
                                <input type="text" id="inputMasterPokmil" class="form-control" placeholder="Baru...">
                                <button class="btn btn-success" type="button" onclick="tambahMaster('pokmil')">Tambah</button>
                            </div>
                            <ul class="list-group" id="listMasterPokmil" style="max-height: 180px; overflow-y: auto;"></ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<!-- FOOTER -->
<div class="container-fluid px-4">
    <div class="custom-footer">
        <span>Designed by <span class="designer-name">Aghmn</span></span>
        <span class="mx-2" style="color: #475569;">|</span>
