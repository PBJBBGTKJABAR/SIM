    async function tarikDataTerbaruPenomoran() {
        document.getElementById('loadingOverlay').style.display = 'flex';
        document.getElementById('loadingText').innerText = "Mengambil data penomoran...";
        try {
            const urlFetch = `${GOOGLE_APP_SCRIPT_URL_PENOMORAN}?kunci=${encodeURIComponent(SECRET_KEY_PENOMORAN)}`;
            const respon = await fetch(urlFetch);
            if (!respon.ok) throw new Error(`HTTP Error: ${respon.status}`);
            const rawText = await respon.text();
            let dataState = JSON.parse(rawText);
            if(dataState.error) throw new Error(dataState.error);
            
            dataAjuanPenomoran = dataState.dataAjuan || [];
            nomorBulananPenomoran = dataState.nomorBulanan || {};
            renderSemuaPenomoran();
        } catch(error) {
            console.error("Detail Error Penomoran:", error);
        } finally {
            document.getElementById('loadingOverlay').style.display = 'none';
        }
    }

    async function simpanKeCloudPenomoran() {
        document.getElementById('loadingOverlay').style.display = 'flex';
        document.getElementById('loadingText').innerText = "Menyimpan ke Spreadsheet...";
        let flatData = [];
        dataAjuanPenomoran.forEach(ajuan => {
            ajuan.listSurat.forEach(surat => {
                flatData.push({
                    "No Urut": String(surat.nomorUrutAsli).padStart(4, '0'),
                    "Nomor Surat Lengkap": surat.nomorLengkap,
                    "Perihal Dokumen": surat.jenis,
                    "Tanggal": new Date(surat.tanggal).toLocaleDateString('id-ID', {day: '2-digit', month: 'long', year:'numeric'}),
                    "Nama Pekerjaan": ajuan.pekerjaan,
                    "Jenis Pengadaan": ajuan.jenisPengadaan,
                    "Penyedia Barang/Jasa": ajuan.penyedia,
                    "Pejabat Pengadaan": ajuan.pejabat
                });
            });
        });

        const payloadKirim = {
            kunci: SECRET_KEY_PENOMORAN,
            state: { dataAjuan: dataAjuanPenomoran, nomorBulanan: nomorBulananPenomoran },
            dataFlat: flatData
        };

        try {
            await fetch(GOOGLE_APP_SCRIPT_URL_PENOMORAN, {
                method: 'POST',
                mode: 'no-cors',
                headers: { 'Content-Type': 'text/plain' },
                body: JSON.stringify(payloadKirim)
            });
            renderSemuaPenomoran();
        } catch (error) {
            console.error(error);
        } finally {
            document.getElementById('loadingOverlay').style.display = 'none';
        }
    }

