            penyedia: document.getElementById('penyediaPenomoran').value,
            listSurat: []
        };

        if (id) {
            const index = dataAjuanPenomoran.findIndex(a => a.id === id);
            ajuanBaru.listSurat = dataAjuanPenomoran[index].listSurat;
            dataAjuanPenomoran[index] = ajuanBaru;
        } else {
            dataAjuanPenomoran.push(ajuanBaru);
        }
        
        mAjuanPenomoran.hide();
        simpanKeCloudPenomoran();
    }

    function hapusAjuanPenomoran(id) {
        if(confirm("Yakin ingin menghapus ajuan ini secara permanen dari server?")) {
            dataAjuanPenomoran = dataAjuanPenomoran.filter(a => a.id !== id);
            simpanKeCloudPenomoran();
        }
    }

    function renderTabelAjuanPenomoran() {
        const tbody = document.getElementById('tabelAjuanPenomoran');
        if(!tbody) return;
        tbody.innerHTML = '';
        if (dataAjuanPenomoran.length === 0) {
            return tbody.innerHTML = `
                <tr><td colspan="7">
                    <div class="empty-state">
                        <i class="bi bi-inboxes"></i>
                        <h5>Belum ada data ajuan</h5>
                        <p class="mb-0">Silakan klik tombol "Tambah Ajuan" untuk memulai.</p>
                    </div>
                </td></tr>`;
        }

        dataAjuanPenomoran.forEach((ajuan, i) => {
            const badgeClass = getWarnaBadgePenomoran(ajuan.jenisPengadaan);
            tbody.innerHTML += `
                <tr>
                    <td class="text-center text-muted fw-bold">${i + 1}</td>
                    <td class="fw-semibold text-dark">${ajuan.pejabat}</td>
                    <td>${ajuan.pekerjaan}</td>
                    <td class="text-center"><span class="badge-pengadaan ${badgeClass}">${ajuan.jenisPengadaan || '-'}</span></td>
                    <td>${ajuan.penyedia}</td>
                    <td class="text-center"><span class="badge bg-light text-dark border px-2 py-1"><i class="bi bi-envelope-paper"></i> ${ajuan.listSurat.length} Surat</span></td>
                    <td class="text-center">
                        <button class="btn btn-action btn-outline-primary" onclick="bukaModalSuratPenomoran('${ajuan.id}')" title="Kelola"><i class="bi bi-gear-fill"></i></button>
                        <button class="btn btn-action btn-outline-warning mx-1" onclick="bukaModalAjuanPenomoran('${ajuan.id}')" title="Edit"><i class="bi bi-pencil-fill"></i></button>
                        <button class="btn btn-action btn-outline-danger" onclick="hapusAjuanPenomoran('${ajuan.id}')" title="Hapus"><i class="bi bi-trash-fill"></i></button>
                    </td>
                </tr>
            `;
        });
    }

    function bukaModalSuratPenomoran(idAjuan) {
        aktifAjuanIdPenomoran = idAjuan;
        const ajuan = dataAjuanPenomoran.find(a => a.id === idAjuan);
        if(!ajuan) return;
        document.getElementById('infoPekerjaanPenomoran').innerText = ajuan.pekerjaan;
        document.getElementById('infoPenyediaPenomoran').innerText = ajuan.penyedia;
        batalEditSuratPenomoran();
        renderTabelSuratPenomoran();
        mSuratPenomoran.show();
    }

    // Fungsi interaktif ketika nama pekerjaan di tab Daftar Pengadaan diklik
    function bukaModalSuratPenomoranDariDaftar(idPengadaan) {
        let item = dataPengadaan.find(d => Number(d.id) === Number(idPengadaan));
        if(!item) return;
        
        // Cek apakah sudah ada di data ajuan penomoran berdasarkan nama pekerjaan & penyedia
        let ajuanMatch = dataAjuanPenomoran.find(a => a.pekerjaan === item.namaPekerjaan && a.penyedia === item.namaPenyedia);
        if(!ajuanMatch) {
            // Jika belum ada, buat otomatis objek ajuan baru secara instan
            ajuanMatch = {
                id: 'AJN-' + Date.now(),
                pejabat: item.pic || 'Shodiq Ridwanu',
                jenisPengadaan: item.penetapan || 'Barang (B)',
                pekerjaan: item.namaPekerjaan,
                penyedia: item.namaPenyedia || '-',
                listSurat: []
            };
            dataAjuanPenomoran.push(ajuanMatch);
        }

        // Pindah ke tab penomoran secara otomatis, lalu buka modal suratnya
        const triggerEl = document.querySelector('button[data-bs-target="#tab-penomoran"]');
        if(triggerEl) {
            let tabObj = new bootstrap.Tab(triggerEl);
            tabObj.show();
        }

        bukaModalSuratPenomoran(ajuanMatch.id);
    }

    function previewNomorSuratPenomoran() {
        const jenis = document.getElementById('jenisDokumenPenomoran').value;
        const tgl = document.getElementById('tanggalSuratPenomoran').value;
        const idEdit = document.getElementById('editSuratIdPenomoran').value;
        const noUrutAsli = document.getElementById('editNomorUrutAsliPenomoran').value;
        const inputPreview = document.getElementById('previewNomorPenomoran');

        if (jenis && tgl) {
            const kodeArsip = masterDokumenPenomoran[jenis];
            const dateObj = new Date(tgl);
            
            const romawi = ["I", "II", "III", "IV", "V", "VI", "VII", "VIII", "IX", "X", "XI", "XII"];
            const bulanRomawi = romawi[dateObj.getMonth()]; 
            
            const bulanAngka = String(dateObj.getMonth() + 1).padStart(2, '0'); 
            const tahun = dateObj.getFullYear();
            const keyBulanTahun = `${bulanAngka}-${tahun}`;

            let noDipakai = 1;
            if (idEdit) {
                noDipakai = parseInt(noUrutAsli);
            } else {
                noDipakai = nomorBulananPenomoran[keyBulanTahun] || 1;
            }

            const noUrutStr = String(noDipakai).padStart(4, '0');
            inputPreview.value = `${noUrutStr}/${bulanRomawi}/${kodeArsip}/${tahun}`;
        } else {
            inputPreview.value = "";
        }
    }

    function tambahAtauEditSuratPenomoran(e) {
        e.preventDefault();
        const jenis = document.getElementById('jenisDokumenPenomoran').value;
        const tgl = document.getElementById('tanggalSuratPenomoran').value;
        const nomorLengkap = document.getElementById('previewNomorPenomoran').value;
        const editId = document.getElementById('editSuratIdPenomoran').value;
        
        const ajuanIndex = dataAjuanPenomoran.findIndex(a => a.id === aktifAjuanIdPenomoran);

        if (editId) {
            const suratIndex = dataAjuanPenomoran[ajuanIndex].listSurat.findIndex(s => s.id === editId);
            dataAjuanPenomoran[ajuanIndex].listSurat[suratIndex].jenis = jenis;
            dataAjuanPenomoran[ajuanIndex].listSurat[suratIndex].tanggal = tgl;
            dataAjuanPenomoran[ajuanIndex].listSurat[suratIndex].nomorLengkap = nomorLengkap;
        } else {
            const dateObj = new Date(tgl);
            const bulanAngka = String(dateObj.getMonth() + 1).padStart(2, '0'); 
            const tahun = dateObj.getFullYear();
            const keyBulanTahun = `${bulanAngka}-${tahun}`;
            
            const noDipakai = nomorBulananPenomoran[keyBulanTahun] || 1;

            dataAjuanPenomoran[ajuanIndex].listSurat.push({
                id: 'SRT-' + Date.now(),
                jenis: jenis,
                tanggal: tgl,
                nomorLengkap: nomorLengkap,
                nomorUrutAsli: noDipakai,
                kunciBulan: keyBulanTahun
            });
            
            nomorBulananPenomoran[keyBulanTahun] = noDipakai + 1; 
        }

        batalEditSuratPenomoran();
        renderTabelSuratPenomoran();
        simpanKeCloudPenomoran();
    }

    function siapkanEditSuratPenomoran(idSurat) {
        const ajuan = dataAjuanPenomoran.find(a => a.id === aktifAjuanIdPenomoran);
        const surat = ajuan.listSurat.find(s => s.id === idSurat);

        document.getElementById('editSuratIdPenomoran').value = surat.id;
        document.getElementById('editNomorUrutAsliPenomoran').value = surat.nomorUrutAsli;
        document.getElementById('jenisDokumenPenomoran').value = surat.jenis;
        document.getElementById('tanggalSuratPenomoran').value = surat.tanggal;
        
        document.getElementById('btnSubmitSuratPenomoran').innerHTML = "<i class='bi bi-check2'></i> Simpan Edit";
        document.getElementById('btnSubmitSuratPenomoran').classList.replace('btn-primary', 'btn-warning');
        document.getElementById('btnBatalEditPenomoran').classList.remove('d-none');
        
        previewNomorSuratPenomoran();
    }

    function batalEditSuratPenomoran() {
        document.getElementById('formTambahSuratPenomoran').reset();
        document.getElementById('editSuratIdPenomoran').value = '';
        document.getElementById('editNomorUrutAsliPenomoran').value = '';
        document.getElementById('previewNomorPenomoran').value = '';
        
        document.getElementById('btnSubmitSuratPenomoran').innerHTML = "<i class='bi bi-plus-lg'></i> Tambah";
        document.getElementById('btnSubmitSuratPenomoran').classList.replace('btn-warning', 'btn-primary');
        document.getElementById('btnBatalEditPenomoran').classList.add('d-none');
    }

    function hapusSuratPenomoran(idSurat) {
        if(confirm("Hapus nomor surat ini dari server?")) {
            const ajuanIndex = dataAjuanPenomoran.findIndex(a => a.id === aktifAjuanIdPenomoran);
            dataAjuanPenomoran[ajuanIndex].listSurat = dataAjuanPenomoran[ajuanIndex].listSurat.filter(s => s.id !== idSurat);
            renderTabelSuratPenomoran();
            simpanKeCloudPenomoran();
        }
    }

    function renderTabelSuratPenomoran() {
        const tbody = document.getElementById('tabelSuratPenomoran');
        const ajuan = dataAjuanPenomoran.find(a => a.id === aktifAjuanIdPenomoran);
        if(!tbody || !ajuan) return;
        tbody.innerHTML = '';

        if(ajuan.listSurat.length === 0){
            tbody.innerHTML = `<tr><td colspan="5" class="text-center text-muted py-4"><i class="bi bi-file-earmark-x fs-4 d-block mb-2"></i> Belum ada surat yang diterbitkan.</td></tr>`;
            return;
        }

        const sortedSurat = [...ajuan.listSurat].sort((a,b) => new Date(a.tanggal) - new Date(b.tanggal));

        sortedSurat.forEach((surat) => {
            const tglFmt = new Date(surat.tanggal).toLocaleDateString('id-ID', {day: '2-digit', month: 'short', year:'numeric'});
            tbody.innerHTML += `
                <tr>
                    <td class="text-center fw-bold text-secondary bg-light">${String(surat.nomorUrutAsli).padStart(4, '0')}</td>
                    <td>${surat.jenis}</td>
                    <td class="text-success fw-bold">${surat.nomorLengkap}</td>
                    <td>${tglFmt}</td>
                    <td class="text-center aksi-kolom-penomoran">
                        <button class="btn btn-action btn-outline-warning" onclick="siapkanEditSuratPenomoran('${surat.id}')" title="Edit"><i class="bi bi-pencil-fill"></i></button>
                        <button class="btn btn-action btn-outline-danger mx-1" onclick="hapusSuratPenomoran('${surat.id}')" title="Hapus"><i class="bi bi-trash-fill"></i></button>
                    </td>
                </tr>
            `;
        });
    }

    function renderRekapGlobalPenomoran() {
        const tbody = document.getElementById('tabelRekapGlobalPenomoran');
        if(!tbody) return;
        tbody.innerHTML = '';
        let semuaSurat = [];
        dataAjuanPenomoran.forEach(ajuan => {
            ajuan.listSurat.forEach(surat => {
                semuaSurat.push({ ...surat, pekerjaan: ajuan.pekerjaan, penyedia: ajuan.penyedia });
            });
        });
        
        semuaSurat.sort((a, b) => {
            const dateA = new Date(a.tanggal);
            const dateB = new Date(b.tanggal);
            if (dateA < dateB) return -1;
            if (dateA > dateB) return 1;
            return a.nomorUrutAsli - b.nomorUrutAsli;
        });
        
        if(semuaSurat.length === 0) {
             return tbody.innerHTML = `
                <tr><td colspan="6">
                    <div class="empty-state">
                        <i class="bi bi-file-earmark-x"></i>
                        <h5>Belum ada surat diterbitkan</h5>
                    </div>
                </td></tr>`;
        }

        semuaSurat.forEach(s => {
            const tglFmt = new Date(s.tanggal).toLocaleDateString('id-ID', {day: '2-digit', month: 'short', year:'numeric'});
            tbody.innerHTML += `
                <tr>
                    <td class="text-center fw-bold text-secondary">${String(s.nomorUrutAsli).padStart(4, '0')}</td>
                    <td class="text-primary fw-bold"><i class="bi bi-hash text-muted"></i> ${s.nomorLengkap}</td>
                    <td>${s.jenis}</td>
                    <td>${tglFmt}</td>
                    <td class="text-muted"><small>${s.pekerjaan}</small></td>
                    <td class="fw-semibold text-slate-700">${s.penyedia}</td>
                </tr>
            `;
        });
    }

    function unduhPDFPenomoran() {
        const elemen = document.getElementById('areaCetakPDFPenomoran');
        document.getElementById('kopPDFPenomoran').classList.remove('d-none');
        document.getElementById('kopKerjaPenomoran').innerText = document.getElementById('infoPekerjaanPenomoran').innerText;
        document.getElementById('kopPenyediaDataPenomoran').innerText = document.getElementById('infoPenyediaPenomoran').innerText;
        
        const aksiKolom = document.querySelectorAll('.aksi-kolom-penomoran');
        aksiKolom.forEach(el => el.style.display = 'none');

        const opt = {
            margin: 10,
            filename: 'Daftar_Nomor_Surat.pdf',
            image: { type: 'jpeg', quality: 0.98 },
            html2canvas: { scale: 2 },
            jsPDF: { unit: 'mm', format: 'a4', orientation: 'landscape' }
        };

        html2pdf().set(opt).from(elemen).save().then(() => {
            document.getElementById('kopPDFPenomoran').classList.add('d-none');
            aksiKolom.forEach(el => el.style.display = '');
        });
    }

    // Inisialisasi awal aplikasi
    document.getElementById('iframeDB').src = linkDB;
    renderMasterSettings();
    muatDataDariSpreadsheet();
    inisialisasiPenomoran();
</script>

