                            noBast: val('nobast') || '-',
                            tglBast: val('tglbast') || '-',
                            caraBayar: val('carapembayaran') || val('carabayar') || '-',
                            petugas: val('petugaspengadaan') || val('petugas') || '-',
                            noSpm: val('nospm') || '-',
                            tglSpm: val('tglspm') || '-',
                            noSp2d: val('nosp2d') || '-',
                            tglSp2d: val('tglsp2d') || '-',
